<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="1. Cấp quyền đọc thông báo" />

    <Button
        android:id="@+id/btnBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Tắt tối ưu pin" />

    <Button
        android:id="@+id/btnAppSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Bật Tự khởi động (Xiaomi)" />

    <Button
        android:id="@+id/btnTestVoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔊 Thử giọng đọc" />

    <Switch
        android:id="@+id/swOutgoing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:text="Đọc cả tiền ra (khi bị trừ tiền)"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/txtLast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#F2F2F2"
        android:padding="8dp"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="4. Tick app ngân hàng / ví cần đọc:"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/listApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
